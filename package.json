{
  "name": "waitly",
  "version": "0.0.0",
  "private": true,
  "description": "Waitly monorepo — Vite + React frontend and Hono Cloudflare Worker backend.",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm-run-all build:backend build:frontend",
    "build:backend": "npm --prefix backend run cf-typegen",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm-run-all --parallel typecheck:backend typecheck:frontend",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "format": "prettier --write \"backend/src/**/*.{ts,json,md}\" \"frontend/src/**/*.{ts,tsx,css,md}\"",
    "cf-typegen": "npm-run-all --parallel cf-typegen:backend cf-typegen:frontend",
    "cf-typegen:backend": "npm --prefix backend run cf-typegen",
    "cf-typegen:frontend": "npm --prefix frontend run cf-typegen",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3"
  }
}
